# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production runtime
# Active production host: Vercel. Configure production values in Vercel Environment Variables.
# Canonical production origin: https://usability-testing-platform.vercel.app/

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current browser/server-public API key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback supported by the existing application through end of 2026.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
# Preferred provider-neutral server-only elevated key.
SUPABASE_SECRET_KEY=
# Server-only legacy fallback when the Supabase project still exposes a service-role key.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional Cloudflare Workers fallback / compatibility QA only.
# These are not required for the active Vercel production path.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=usability-testing-platform

# Figma — simplified V1 public prototype embed
# Basic public embed requires no Figma credential.
# Live Embed API access/event preflight uses this PUBLIC app client id after the
# UTP Vercel production origin is registered in the Figma app's Embed API settings.
FIGMA_EMBED_CLIENT_ID=

# Deferred/legacy OAuth + REST proof routes only; do not configure these for the simplified V1 path.
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
FIGMA_REDIRECT_URI=http://localhost:3000/api/integrations/figma/callback
FIGMA_POC_FILE_KEY=
FIGMA_POC_VERSION_ID=
FIGMA_POC_START_NODE_ID=

# Event collector — hosting-provider-neutral server-only token signing/gating
NEXT_PUBLIC_EVENT_COLLECTOR_URL=/v1/events
EVENT_INGESTION_TOKEN_SECRET=
# Required explicit product/ops value; no code default is assumed.
EVENT_INGESTION_RATE_LIMIT_PER_MINUTE=

# Optional Cloudflare R2 object storage.
# Do not configure unless a current UTP task explicitly requires R2; canonical
# application data and raw-event persistence remain in Supabase by default.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
